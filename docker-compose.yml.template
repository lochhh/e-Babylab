services:
  nginx:
    image: nginx
    ports:
      - "8080:80"
      - "8443:443"
    volumes:
      - static_volume:/ipl/static:ro
      - ./media:/ipl/media:ro
      - ./webcam:/ipl/webcam:ro
      - ./reports:/ipl/reports:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - /etc/ssl/certs/<your_ssl_cert.pem>:/etc/ssl/certs/cert.pem
      - /etc/ssl/private/<your_ssl_private_key.key>:/etc/ssl/private/server.key
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
    depends_on:
      - web
    restart: always
  db:
    image: postgres
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
    env_file: ./.env
    environment:
      - POSTGRES_PASSWORD=${DB_PASSWORD}
      - POSTGRES_USER=${DB_USER}
      - POSTGRES_DB=${DB_NAME}
      - POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=scram-sha-256
    volumes:
      - postgres_data:/var/lib/postgresql
    restart: always
  web:
    build:
      context: .
      target: prod
    image: ipl:latest
    depends_on:
      - db
    volumes:
      - static_volume:/usr/src/app/static
      - ./media:/usr/src/app/media
      - ./webcam:/usr/src/app/webcam
      - ./reports:/usr/src/app/reports
    command: "./wait-for-it.sh db:5432 -- sh -c 'python manage.py collectstatic --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:8000'"
    env_file: ./.env
    environment:
      - DJANGO_ENV=prod
    logging:
      driver: "json-file"
      options:
        max-size: "5m"
    restart: always
  pgadmin:
    image: dpage/pgadmin4
    env_file: ./.env
    environment:
      PGADMIN_DEFAULT_EMAIL: ${PGADMIN_EMAIL}
      PGADMIN_DEFAULT_PASSWORD: ${PGADMIN_PASSWORD}
    depends_on:
      - db
    logging:
      driver: "json-file"
      options:
        max-size: "5m"

volumes:
  postgres_data:
  static_volume:
