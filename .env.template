# Copy this file to .env at the project root and fill in the values.

# Legend:
# - REQUIRED: must be set before use
# - OPTIONAL: can be left commented out

# Django
# REQUIRED: generate your own secret key (do not keep defaults)
SECRET_KEY=CHANGE_ME__GENERATE_A_LONG_RANDOM_SECRET_KEY

# CAPTCHA provider
# OPTIONAL: choose a CAPTCHA provider.
# Valid values: altcha, turnstile, trustsig, none
CAPTCHA_PROVIDER=altcha

# ALTCHA (default) — self-hosted proof-of-work, GDPR compliant, no third-party requests
# OPTIONAL if CAPTCHA_PROVIDER=altcha — defaults to a key derived from SECRET_KEY.
# Set explicitly to rotate the ALTCHA key independently of SECRET_KEY.
# Generate a random HMAC key: openssl rand -hex 32
# ALTCHA_HMAC_KEY=

# Cloudflare Turnstile — easy setup, zero server maintenance
# REQUIRED if CAPTCHA_PROVIDER=turnstile — leave commented otherwise
# Register at https://dash.cloudflare.com/ → Turnstile
# CLOUDFLARE_TURNSTILE_SITE_KEY=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=

# TrustSig — invisible bot protection, EU-hosted (Germany), GDPR compliant
# REQUIRED if CAPTCHA_PROVIDER=trustsig — leave commented otherwise
# Register at https://trustsig.eu/
# TRUSTSIG_SITE_KEY=
# TRUSTSIG_SECRET_KEY=

# Database connection
# REQUIRED: change DB_PASSWORD before deploying to production
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CHANGE_ME__SET_A_STRONG_PASSWORD_FOR_PROD
DB_HOST=db
DB_PORT=5432

# pgAdmin (local development only)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Production domain and TLS certificates
# REQUIRED: uncomment and set all three for production deployment
# DOMAIN=example.com
# SSL_CERT_PATH=/etc/ssl/certs/your_cert.pem
# SSL_KEY_PATH=/etc/ssl/private/your_key.key

# Docker image tag
# OPTIONAL: use a specific e-Babylab release (e.g. 2.0.0)
IMAGE_TAG=latest

# PostgreSQL data directory
# OPTIONAL: change to a custom path (e.g. /mnt/ssd/postgres_data)
POSTGRES_DATA_PATH=./postgres_data

# Admin account for the e-Babylab admin interface
# OPTIONAL: uncomment all three to auto-create on first startup
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=CHANGE_ME__SET_A_STRONG_PASSWORD
