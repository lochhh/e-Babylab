# Copy this file to .env at the project root and fill in the values.

# Legend:
# - REQUIRED: must be set before production use
# - RECOMMENDED: should be changed for most setups

# Django
# REQUIRED: generate your own secret key (do not keep defaults)
SECRET_KEY=CHANGE_ME__GENERATE_A_LONG_RANDOM_SECRET_KEY

# Google reCAPTCHA
# REQUIRED: register your site with Google reCAPTCHA to get these keys
GOOGLE_RECAPTCHA_SITE_KEY=CHANGE_ME__GET_FROM_GOOGLE_RECAPTCHA
GOOGLE_RECAPTCHA_SECRET_KEY=CHANGE_ME__GET_FROM_GOOGLE_RECAPTCHA

# Database connection
# REQUIRED: change DB_PASSWORD before deploying to production
# RECOMMENDED: set DB_NAME/DB_USER to your project-specific values
# DB_HOST: use "db" with Docker Compose, "localhost" when running outside Docker
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CHANGE_ME__SET_A_STRONG_PASSWORD_FOR_PROD
DB_HOST=db
DB_PORT=5432

# pgAdmin
# REQUIRED: change these before deploying to production
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME__SET_A_STRONG_PASSWORD_FOR_PROD