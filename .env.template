# Copy this file to .env at the project root and fill in the values.

# Legend:
# - REQUIRED: must be set before use
# - OPTIONAL: can be left commented out

# Django
# REQUIRED: generate your own secret key (do not keep defaults)
SECRET_KEY=CHANGE_ME__GENERATE_A_LONG_RANDOM_SECRET_KEY

# Cloudflare Turnstile
# REQUIRED: register your site at https://dash.cloudflare.com/ → Turnstile to get these keys
CLOUDFLARE_TURNSTILE_SITE_KEY=CHANGE_ME__GET_FROM_CLOUDFLARE_TURNSTILE
CLOUDFLARE_TURNSTILE_SECRET_KEY=CHANGE_ME__GET_FROM_CLOUDFLARE_TURNSTILE

# Database connection
# REQUIRED: change DB_PASSWORD before deploying to production
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CHANGE_ME__SET_A_STRONG_PASSWORD_FOR_PROD
DB_HOST=db
DB_PORT=5432

# pgAdmin (local development only)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Production domain and TLS certificates
# REQUIRED: uncomment and set all three for production deployment
# DOMAIN=example.com
# SSL_CERT_PATH=/etc/ssl/certs/your_cert.pem
# SSL_KEY_PATH=/etc/ssl/private/your_key.key

# Docker image tag
# OPTIONAL: use a specific e-Babylab release (e.g. 2.0.0)
IMAGE_TAG=latest

# PostgreSQL data directory
# OPTIONAL: change to a custom path (e.g. /mnt/ssd/postgres_data)
POSTGRES_DATA_PATH=./postgres_data

# Admin account for the e-Babylab admin interface
# OPTIONAL: uncomment all three to auto-create on first startup
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=CHANGE_ME__SET_A_STRONG_PASSWORD